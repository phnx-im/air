{# Template for `cargo xtask flatpak-sources` -#}
id: '{{ app_id }}'
runtime: org.freedesktop.Platform
runtime-version: '26.08'
sdk: org.freedesktop.Sdk
sdk-extensions:
  # Used by Flutter to build the main app
  - org.freedesktop.Sdk.Extension.llvm23
command: air
{%- if flavor == Flavor::Staging %}
rename-desktop-file: ms.air.Air.desktop
rename-icon: ms.air.Air
rename-appdata-file: ms.air.Air.metainfo.xml
{%- endif %}
finish-args:
  - --share=ipc
  - --share=network
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri
modules:
  - generated/rustup.json
  - generated/flutter-sdk.json
  - name: air
    buildsystem: simple
    build-options:
      append-path: /usr/lib/sdk/llvm23/bin:/var/lib/flutter/bin:/run/build/air/home/.cargo/bin
      prepend-ld-library-path: /usr/lib/sdk/llvm23/lib
      env:
        # Needed for the Rustup toolchain
        HOME: /run/build/air/home
        PUB_CACHE: /run/build/air/pub-cache
        APP_FLAVOR: '{{ flavor }}'
        SQLX_OFFLINE: 'true'
    build-commands:
      # Setup the Rust toolchain in $HOME
      - mkdir -p $HOME/.cargo $HOME/.rustup
      - ln -s /var/lib/rustup/toolchains /var/lib/rustup/update-hashes $HOME/.rustup/
      - cp /var/lib/rustup/settings.toml $HOME/.rustup/
      - ln -s /var/lib/cargo/bin $HOME/.cargo/bin
      - cp cargo-config.toml $HOME/.cargo/config.toml
      - rustup override set {{ rust_channel }} --path /run/build/air/src/applogic
      # Build
      - cd src/app && flutter pub get --offline --enforce-lockfile
      - cd src/app && flutter build linux --release --flavor {{ flavor }} --no-pub --build-number={{ build_number }}
      # Install
      - install -d /app/lib/air /app/bin
      - cp -a src/app/build/linux/*/{{ flavor }}/release/bundle/. /app/lib/air/
      - ln -s ../lib/air/air /app/bin/air
      - install -Dm644 -t /app/share/applications src/app/linux/ms.air.Air.desktop
      - install -Dm644 -t /app/share/icons/hicolor/scalable/apps src/app/linux/ms.air.Air.svg
      - install -Dm644 -t /app/share/metainfo src/app/linux/ms.air.Air.metainfo.xml
      - install -Dm644 -t /app/share/licenses/$FLATPAK_ID src/LICENSES/AGPL-3.0-or-later.txt
      - install -Dm644 air.service /app/share/dbus-1/services/$FLATPAK_ID.service
    sources:
      - generated/air-sources.json
      - generated/pubspec-sources.json
      - generated/cargo-sources.json
      - type: inline
        dest-filename: air.service
        contents: |
          [D-BUS Service]
          Name={{ app_id }}
          Exec=air --gapplication-service
      # Variables forwarded by Flutter's native assets builder from Dart to Rust
      - type: inline
        dest: src/app/.dart_tool
        dest-filename: air_hook_config.json
        contents: >-
          {"cargo_env": {"AIR_BUILD_NUMBER": "{{ build_number }}",
          "AIR_REFRESH_BUILD_METADATA": "{{ commit }}"}}
