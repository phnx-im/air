  "query": "SELECT\n            m.message_id AS \"message_id: MessageId\",\n            m.timestamp AS \"timestamp: TimeStamp\",\n            m.content,\n            c.group_id\n        FROM message m\n        INNER JOIN chat c ON c.chat_id = m.chat_id\n        WHERE m.sender_user_uuid IS NULL",
