  "query": "\n            SELECT\n                a.message_id AS \"message_id: _\",\n                a.attachment_id AS \"attachment_id: _\",\n                a.is_animated,\n                a.has_alpha\n            FROM attachment a\n            JOIN message m USING (message_id)\n            WHERE m.chat_id = ?\n                AND (m.timestamp, m.message_id) >= (?, ?)\n                AND (m.timestamp, m.message_id) <= (?, ?)\n            ORDER BY a.message_id, a.rowid\n            ",
